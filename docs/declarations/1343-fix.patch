+  type SmokeReport,
+  type SmokeScenario,
+  type WorkerSmokeCommentRecord,
+  type WorkerSmokeTrustedTarget,
+} from './lib/worker-smoke-core.ts';
+import { writeWorkerSmokeReceipt } from './lib/worker-smoke-receipt.ts';
+import { DeterministicRuntimeAdapter } from './runtime/test-adapter.ts';
+import {
+  exactClosingIssue,
+  finalSmokeCommentSnapshotMatches,
+  findVerifiedSmokeReceiptWitness,
+  resolveSmokeTarget,
+  type CliOptions,
+} from './worker-smoke-run.ts';
+
+const HEAD = 'a'.repeat(40);
+const REPOSITORY = 'chetwerikoff/orchestrator-pack';
+const ACTOR = 'pack-publisher';
+const ISSUE = 1343;
+const PR = 2001;
+
+function planBody(rows: readonly { action: string; expected: string }[]): string {
+  return [
+    '```behavior-kind',
+    'action-producing',
+    '```',
+    '',
+    '```smoke-test-plan',
+    'scenarios:',
+    ...rows.map((row) => `  - action: ${row.action} | expected: ${row.expected}`),
+    '```',
+  ].join('\n');
+}
+
+function scenario(
+  action: string,
+  expected: string,
+  outcome: SmokeScenario['outcome'] = 'pass',
+): SmokeScenario {
+  return { action, expected, observed: `${outcome ?? 'unknown'} observed`, outcome };
+}
+
+function report(
+  result: SmokeReport['result'],
+  scenarios: SmokeScenario[],
+  terminalHandle: string,
+): SmokeReport {
+  return {
+    result,
+    issueNumber: ISSUE,
+    prNumber: PR,
+    headSha: HEAD,
+    scenarios,
+    limitations: [],
+    trackedFilesUnmodified: true,
+    terminalCleanup: 'closed_owned_handle',
+    environmentNotes: [],
+    producer: SMOKE_REPORT_PRODUCER,
+    orcaExecutable: 'runtime-adapter',
+    terminalHandle,
+  };
+}
+
+function comment(
+  id: number,
+  smokeReport: SmokeReport,
+  body = formatSmokeReportComment(smokeReport),
+): WorkerSmokeCommentRecord {
+  const createdAt = new Date(Date.UTC(2026, 7, 6, 0, 0, 0, id)).toISOString();
+  return {
+    id,
+    body,
+    created_at: createdAt,
+    updated_at: createdAt,
+    user: { login: ACTOR },
+  };
+}
+
+function target(): WorkerSmokeTrustedTarget {
+  return {
+    repositorySlug: REPOSITORY,
+    issueNumber: ISSUE,
+    prNumber: PR,
+    headSha: HEAD,
+    resolvedIssueNumber: ISSUE,
+    resolvedPrNumber: PR,
+    liveHeadSha: HEAD,
+    issueBodyMatchesTarget: true,
+    trustedPublisherLogin: ACTOR,
+    commentCensusComplete: true,
+    commentSnapshotStable: true,
+  };
+}
+
+function coverage(body: string, comments: readonly WorkerSmokeCommentRecord[]) {
+  return evaluateWorkerSmokeCoverage({ issueBody: body, comments, target: target() });
+}
+
+describe('worker-smoke production gate regressions', () => {
+  it('reuses the canonical closing grammar and rejects missing or multiple relations', () => {
+    for (const keyword of [
+      'Close', 'Closes', 'Closed',
+      'Fix', 'Fixes', 'Fixed',
+      'Resolve', 'Resolves', 'Resolved',
+    ]) {
+      expect(exactClosingIssue(`${keyword} #${ISSUE}`)).toBe(ISSUE);
+    }
+    expect(exactClosingIssue('No closing relation')).toBeUndefined();
+    expect(exactClosingIssue(`Closes #${ISSUE}\nFixes #${ISSUE}`)).toBeUndefined();
+    expect(exactClosingIssue(`Closes #${ISSUE}\nFixes #999`)).toBeUndefined();
+  });
+
+  it('preserves exact Issue-body bytes from the PowerShell caller into target resolution', () => {
+    const root = mkdtempSync(join(tmpdir(), 'worker-smoke-target-'));
+    const bin = join(root, 'bin');
+    mkdirSync(bin, { recursive: true });
+    const issueBody = planBody([{ action: 'caller writes exact bytes', expected: 'gate reads exact bytes' }]);
+    const bodyFile = join(root, 'issue.md');
+    const fakeGh = join(bin, 'gh');
+    const fakeGhSource = `#!/usr/bin/env node
+const args = process.argv.slice(2);
+const head = process.env.FAKE_HEAD;
+const body = process.env.FAKE_ISSUE_BODY;
+if (args[0] === 'repo' && args[1] === 'view') {
+  process.stdout.write(JSON.stringify({ nameWithOwner: '${REPOSITORY}' }));
+} else if (args[0] === 'api' && args[1] === 'user') {
+  process.stdout.write(JSON.stringify({ login: '${ACTOR}' }));
+} else if (args[0] === 'issue' && args[1] === 'view') {
+  process.stdout.write(JSON.stringify({
+    number: ${ISSUE}, title: 'issue', body,
+    url: 'https://github.com/${REPOSITORY}/issues/${ISSUE}',
+    state: 'OPEN', stateReason: null, labels: [], assignees: [],
+  }));
+} else if (args[0] === 'pr' && args[1] === 'view' && args.includes('body,number')) {
+  process.stdout.write(JSON.stringify({ number: ${PR}, body: 'Close #${ISSUE}' }));
+} else if (args[0] === 'pr' && args[1] === 'view') {
+  process.stdout.write(JSON.stringify({
+    number: ${PR}, headRefOid: head, baseRefName: 'main', state: 'OPEN',
+  }));
+} else {
+  process.stderr.write('unexpected fake-gh argv: ' + JSON.stringify(args));
+  process.exitCode = 2;
+}
+`;
+    writeFileSync(fakeGh, fakeGhSource, 'utf8');
+    chmodSync(fakeGh, 0o755);
+
+    const gitInit = spawnSync('git', ['init', '--quiet', root], { encoding: 'utf8' });
+    expect(gitInit.status, gitInit.stderr).toBe(0);
+    const gitRemote = spawnSync(
+      'git',
+      ['-C', root, 'remote', 'add', 'origin', `https://github.com/${REPOSITORY}.git`],
+      { encoding: 'utf8' },
+    );
+    expect(gitRemote.status, gitRemote.stderr).toBe(0);
+
+    const script = resolve('scripts/pack-worker-report.ps1').replaceAll("'", "''");
+    const output = bodyFile.replaceAll("'", "''");
+    const env = {
+      ...process.env,
+      PATH: `${bin}:${process.env.PATH ?? ''}`,
+      FAKE_HEAD: HEAD,
+      FAKE_ISSUE_BODY: issueBody,
+    };
+    const writer = spawnSync(
+      'pwsh',
+      ['-NoProfile', '-Command',
+        `& { . '${script}' -LoadFunctionsOnly; Write-WorkerSmokeIssueBodyFile -Path '${output}' -Body $env:FAKE_ISSUE_BODY }`],
+      { encoding: 'utf8', env },
+    );
+    expect(writer.status, `${writer.stdout}\n${writer.stderr}`).toBe(0);
+    expect(readFileSync(bodyFile, 'utf8')).toBe(issueBody);
+
+    const previousPath = process.env.PATH;
+    const previousBody = process.env.FAKE_ISSUE_BODY;
+    const previousHead = process.env.FAKE_HEAD;
+    process.env.PATH = env.PATH;
+    process.env.FAKE_ISSUE_BODY = issueBody;
+    process.env.FAKE_HEAD = HEAD;
+    try {
+      const options: CliOptions = {
+        command: 'gate-check',
+        issueNumber: ISSUE,
+        prNumber: PR,
+        headSha: HEAD,
+        repositorySlug: REPOSITORY,
+        issueBodyFile: bodyFile,
+        repoRoot: root,
+        cwd: root,
+        dryRun: false,
+        json: true,
+      };
+      const resolved = resolveSmokeTarget(options, readFileSync(bodyFile, 'utf8'));
+      expect(resolved.repositorySlug).toBe(REPOSITORY);
+      expect(resolved.issueBody).toBe(issueBody);
+      expect(resolved.trustedPublisherLogin).toBe(ACTOR);
+    } finally {
+      if (previousPath === undefined) delete process.env.PATH;
+      else process.env.PATH = previousPath;
+      if (previousBody === undefined) delete process.env.FAKE_ISSUE_BODY;
+      else process.env.FAKE_ISSUE_BODY = previousBody;
+      if (previousHead === undefined) delete process.env.FAKE_HEAD;
+      else process.env.FAKE_HEAD = previousHead;
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  it('uses comment publication order even when receipt writes finish in the opposite order', () => {
+    const root = mkdtempSync(join(tmpdir(), 'worker-smoke-receipt-order-'));
+    const previousRoot = process.env.WORKER_SMOKE_RECEIPT_ROOT;
+    process.env.WORKER_SMOKE_RECEIPT_ROOT = root;
+    try {
+      const body = planBody([
+        { action: 'A', expected: 'A passes' },
+        { action: 'B', expected: 'B passes' },
+      ]);
+      const first = report('PASS', [scenario('A', 'A passes')], 'terminal-a');
+      const second = report('PASS', [scenario('B', 'B passes')], 'terminal-b');
+      const folded = coverage(body, [comment(1, first), comment(2, second)]);
+      expect(folded.accepting).toBe(true);
+      expect(folded.latestClearingPass?.terminalHandle).toBe('terminal-b');
+
+      writeWorkerSmokeReceipt(second);
+      writeWorkerSmokeReceipt(first);
+      const witness = findVerifiedSmokeReceiptWitness(folded.receiptWitnesses ?? []);
+      expect(witness?.terminalHandle).toBe('terminal-a');
+
+      const decision = evaluateWorkerSmokeGate({
+        issueBody: body,
+        issueNumber: ISSUE,
+        prNumber: PR,
+        headSha: HEAD,
+        prComments: [comment(1, first), comment(2, second)],
+        ciGreen: true,
+        orcaWorktreeOk: true,
+        ownedTerminalClosed: Boolean(witness),
+        terminalProvenanceOk: Boolean(witness),
+        repositorySlug: REPOSITORY,
+        resolvedIssueNumber: ISSUE,
+        resolvedPrNumber: PR,
+        liveHeadSha: HEAD,
+        issueBodyMatchesTarget: true,
+        trustedPublisherLogin: ACTOR,
+        commentCensusComplete: true,
+        commentSnapshotStable: true,
+      });
+      expect(decision.allowed).toBe(true);
+
+      const revocation = report('FAIL', [scenario('B', 'B passes', 'fail')], 'terminal-c');
+      expect(coverage(body, [comment(1, first), comment(2, second), comment(3, revocation)]).accepting)
+        .toBe(false);
+    } finally {
+      if (previousRoot === undefined) delete process.env.WORKER_SMOKE_RECEIPT_ROOT;
+      else process.env.WORKER_SMOKE_RECEIPT_ROOT = previousRoot;
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  it('denies allow when an immediate final census contains a same-head revocation', () => {
+    const body = planBody([{ action: 'A', expected: 'A passes' }]);
+    const pass = comment(1, report('PASS', [scenario('A', 'A passes')], 'terminal-a'));
+    const blocked = comment(2, report('BLOCKED', [scenario('A', 'A passes', 'blocked')], 'terminal-b'));
+    expect(finalSmokeCommentSnapshotMatches([pass], [pass])).toBe(true);
+    expect(finalSmokeCommentSnapshotMatches([pass], [pass, blocked])).toBe(false);
+  });
+
+  it('applies result-independent malformed BLOCKED admission', () => {
+    const body = planBody([{ action: 'A', expected: 'A passes' }]);
+    const pass = report('PASS', [scenario('A', 'A passes')], 'terminal-a');
+    const malformed = report('BLOCKED', [scenario('A', 'A passes', 'blocked')], 'terminal-b');
+    malformed.producer = '';
+    const folded = coverage(body, [comment(1, pass), comment(2, malformed)]);
+    expect(folded.accepting).toBe(false);
+    expect(folded.diagnostics.globalBlock.kind).toBe('invalid_candidate');
+    expect(folded.diagnostics.covered.total).toBe(1);
+  });
+
+  it('trims a real combined payload over 64 KiB deterministically without changing totals', () => {
+    const escaped = '\\'.repeat(240);
+    const rows = Array.from({ length: 180 }, (_, index) => ({
+      action: `${escaped} action-${index}`,
+      expected: `${escaped} expected-${index}`,
+    }));
+    const body = planBody(rows);
+    const passRows = rows.slice(0, 60).map((row) => scenario(row.action, row.expected));
+    const failRows = rows.slice(60, 120).map((row) => scenario(row.action, row.expected, 'fail'));
+    const clearingUnknown = scenario('unknown tuple', 'valid top-level clearing PASS');
+    const comments = [
+      comment(1, report('PASS', passRows, 'terminal-a')),
+      comment(2, report('FAIL', failRows, 'terminal-b')),
+      comment(3, report('PASS', [clearingUnknown], 'terminal-c')),
+    ];
+    const first = coverage(body, comments);
+    const second = coverage(body, comments);
+    expect(first.diagnostics.covered.total).toBe(60);
+    expect(first.diagnostics.latestNonPass.total).toBe(60);
+    expect(first.diagnostics.missing.total).toBe(60);
+    expect(first.diagnostics.payloadOverflow).toBe(true);
+    expect(first.diagnostics.payloadBytes).toBeLessThanOrEqual(64 * 1024);
+    expect(Buffer.byteLength(JSON.stringify(first.diagnostics), 'utf8')).toBeLessThanOrEqual(64 * 1024);
+    expect(JSON.stringify(first.diagnostics)).toBe(JSON.stringify(second.diagnostics));
+  });
+
+  it('keeps fresh worker identities and cleanup across several publications', () => {
+    const adapter = new DeterministicRuntimeAdapter();
+    const first = adapter.spawnWorker({ title: 'smoke-1', command: 'cursor-agent' });
+    const second = adapter.spawnWorker({ title: 'smoke-2', command: 'cursor-agent' });
+    expect(first.status).toBe('ok');
+    expect(second.status).toBe('ok');
+    if (first.status !== 'ok' || second.status !== 'ok') return;
+    expect(first.value.identity).not.toEqual(second.value.identity);
+    expect(adapter.stopWorker(first.value.identity).status).toBe('ok');
+    expect(adapter.stopWorker(second.value.identity).status).toBe('ok');
+    expect(adapter.listWorkers()).toEqual({ status: 'ok', value: [] });
+
+    const body = planBody([
+      { action: 'A', expected: 'A passes' },
+      { action: 'B', expected: 'B passes' },
+    ]);
+    const firstReport = report('PASS', [scenario('A', 'A passes')], first.value.identity.id);
+    const secondReport = report('PASS', [scenario('B', 'B passes')], second.value.identity.id);
+    expect(coverage(body, [comment(1, firstReport), comment(2, secondReport)]).accepting).toBe(true);
+  });
+});
