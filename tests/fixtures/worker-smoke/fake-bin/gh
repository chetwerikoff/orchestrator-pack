#!/bin/sh
set -eu
case "${1:-}" in
  api|pr)
    if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ] || [ -n "${GH_CONFIG_DIR:-}" ]; then
      printf '%s\n' '[]'
      exit 0
    fi
    printf '%s\n' 'auth-carrier-missing' >&2
    exit 1
    ;;
  fail-with-sentinel)
    exec "$(dirname "$0")/gh-auth-probe" fail-with-sentinel
    ;;
  *)
    printf '%s\n' 'unsupported-gh-fixture-invocation' >&2
    exit 2
    ;;
esac
