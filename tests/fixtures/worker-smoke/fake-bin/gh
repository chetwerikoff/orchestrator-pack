#!/bin/sh
set -eu
case "${1:-}" in
  api|pr)
    if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
      printf '%s\n' '[]'
      exit 0
    fi
    if [ -n "${GH_CONFIG_DIR:-}" ] && [ -f "${GH_CONFIG_DIR}/hosts.yml" ]; then
      if grep -q 'oauth_token:' "${GH_CONFIG_DIR}/hosts.yml"; then
        printf '%s\n' '[]'
        exit 0
      fi
      printf '%s\n' 'config-credential-missing' >&2
      exit 1
    fi
    if [ -n "${GH_CONFIG_DIR:-}" ]; then
      printf '%s\n' 'config-credential-missing' >&2
      exit 1
    fi
    printf '%s\n' 'auth-carrier-missing' >&2
    exit 1
    ;;
  fail-with-sentinel)
    exec "$(dirname "$0")/gh-auth-probe" fail-with-sentinel
    ;;
  fail-with-config-sentinel)
    if [ -n "${GH_CONFIG_DIR:-}" ] && [ -f "${GH_CONFIG_DIR}/hosts.yml" ]; then
      grep 'oauth_token:' "${GH_CONFIG_DIR}/hosts.yml" >&2 || true
    fi
    printf '%s\n' 'config-auth-failed' >&2
    exit 1
    ;;
  *)
    printf '%s\n' 'unsupported-gh-fixture-invocation' >&2
    exit 2
    ;;
esac
