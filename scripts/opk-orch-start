#!/usr/bin/env -S node --experimental-strip-types
import './toolchain/native-entrypoint-preflight.ts';
import { runProductionExistingOpenCodeResume } from './pr2-foundation/supervised-task-launch-assistant.ts';
import { runOpkOrchStart } from './orca-runtime/orchestrator-attach.ts';

const invokedDirectly = import.meta.url === new URL(process.argv[1] ?? '', 'file:').href;
if (invokedDirectly) {
  runOpkOrchStart(process.argv.slice(2), {
    env: process.env,
    resume: (session, env) => runProductionExistingOpenCodeResume(session, env),
  }).then((code) => {
    process.exitCode = code;
  }).catch((error) => {
    process.stderr.write(`opk-orch-start refused: ${error instanceof Error ? error.message : String(error)}\n`);
    process.exitCode = 1;
  });
}
