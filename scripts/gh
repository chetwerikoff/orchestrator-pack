#!/usr/bin/env bash
# Pack gh shim — always-REST inventory reads; unknown argv passthrough (Issue #431).
# Temporary operator REST unblock branches remain owned by Issues #530/#531.
# Prepend pack scripts/ to PATH (#318 / #128) so this intercepts gh invocations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# In target mode, authorize the selected project card before any native/network gh path.
# The helper reuses resolveTargetContext, rejects mismatched repo/host ingress, and prints
# the exact repository that all implicit gh routing must use.
if [[ -n "${OPK_PROJECT_ID:-}" ]]; then
  target_authorization="$(node --no-warnings --experimental-strip-types "${SCRIPT_DIR}/lib/gh-target-authorization.ts" -- "$@")"
  read -r target_repo target_default_branch <<< "$target_authorization"
  if [[ -z "$target_repo" || -z "$target_default_branch" ]]; then
    echo "target gh authorization returned incomplete repository/default-branch binding" >&2
    exit 1
  fi
  export OPK_TARGET_REPOSITORY="$target_repo"
  export OPK_TARGET_DEFAULT_BRANCH="$target_default_branch"
  export GH_REPO="$target_repo"
  export GH_HOST="github.com"
fi

if [[ "${GH_WRAPPER_ACTIVE:-}" == "1" ]]; then
  # Terminal delegation: resolve native gh, not next wrapper on PATH (Issue #442).
  real_gh="$(node "${SCRIPT_DIR}/lib/gh-resolve-real-binary.mjs")"
  exec /usr/bin/env -u GH_WRAPPER_ACTIVE "$real_gh" "$@"
fi

if [[ -n "${OPK_SIDE_PROCESS_CHILD_ID:-}" && -n "${OPK_SIDE_PROCESS_PROGRESS_DIR:-}" && "${OPK_SIDE_PROCESS_LIVENESS_ACTIVE:-}" != "1" ]]; then
  call_name="gh:${1:-command}:${2:-invoke}"
  owner_pid="${OPK_SIDE_PROCESS_OWNER_PID:-$PPID}"
  export OPK_SIDE_PROCESS_LIVENESS_ACTIVE=1
  exec node --no-warnings --experimental-strip-types "${SCRIPT_DIR}/lib/Invoke-TypeScriptCli.ts" \
    --repo-root "${SCRIPT_DIR}/.." \
    --script "${SCRIPT_DIR}/kernel/side-process-liveness.ts" -- call \
    --call-name "$call_name" \
    --child-id "$OPK_SIDE_PROCESS_CHILD_ID" \
    --owner-pid "$owner_pid" \
    --progress-dir "$OPK_SIDE_PROCESS_PROGRESS_DIR" \
    -- bash "${BASH_SOURCE[0]}" "$@"
fi

# All read routing and native passthrough use the shared argv/inventory wrapper.
exec node "${SCRIPT_DIR}/lib/gh-wrapper.mjs" "$@"
