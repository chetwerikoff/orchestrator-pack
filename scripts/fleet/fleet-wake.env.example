# Required: primary checkout for this project. Keep operator-specific values in
# ~/.config/orchestrator-fleet/<project>.env, never in the repository.
PRIMARY=/absolute/path/to/project

# Optional regex overrides. WORKSPACE_RE defaults to orca/workspaces/<basename(PRIMARY)>/.
# WORKSPACE_RE=orca/workspaces/project/
# ORCH_TITLE_RE=Cursor
# ORCH_HANDLE=terminal-handle-to-pin
# BUSY_RE=esc (to )?interrupt|ctrl\+c to stop

# Seconds between sweeps. Default: 300.
FLEET_WAKE_INTERVAL=300
