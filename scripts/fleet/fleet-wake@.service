[Unit]
Description=orchestrator-pack fleet alarm (%i)

[Service]
Type=simple
ExecStart=/usr/bin/env node --experimental-strip-types {PACK_ROOT}/scripts/lib/Invoke-TypeScriptCli.ts --repo-root {PACK_ROOT} --script {PACK_ROOT}/scripts/fleet/fleet-wake.ts -- --project %i
Restart=always
RestartSec=5
StandardOutput=append:%h/.local/state/orchestrator-fleet/%i.fleet-wake.log
StandardError=append:%h/.local/state/orchestrator-fleet/%i.fleet-wake.log

[Install]
WantedBy=default.target
