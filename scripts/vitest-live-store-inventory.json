{
  "schemaVersion": 2,
  "issue": 1352,
  "allowedRoots": [
    "scripts/check-vitest-live-store-isolation.mjs",
    "scripts/vitest-live-store-inventory.json",
    "scripts/vitest-live-store-preload.mjs",
    "scripts/lib/vitest-live-store-harness.mjs",
    "scripts/lib/vitest-live-store-parent-guard.mjs",
    "scripts/run-vitest-with-harness.mjs",
    ".github/workflows",
    "package.json"
  ],
  "liveRoots": [
    {
      "id": "wake-supervisor-state-root",
      "defaultTemplate": "${WAKE_STATE}",
      "harnessEnv": "OPK_WAKE_SUPERVISOR_STATE_DIR",
      "kind": "directory",
      "watchTransient": true
    },
    {
      "id": "pack-state-root",
      "defaultTemplate": "${OPK_BASE}",
      "harnessEnv": "OPK_BASE_DIR",
      "kind": "directory",
      "watchTransient": false
    }
  ],
  "classFences": [
    {
      "id": "temporary-orchestrator-json-class",
      "rootTemplate": "${TMP}",
      "basenamePatterns": [
        "orchestrator-*.json",
        "orchestrator-*.json.tmp",
        "orchestrator-*.json.bak",
        "orchestrator-*.json.corrupt-*"
      ],
      "watchTransient": true
    },
    {
      "id": "temporary-orchestrator-lock-class",
      "rootTemplate": "${TMP}",
      "basenamePatterns": ["orchestrator-*.lock"],
      "watchTransient": true
    }
  ],
  "stores": [
    {
      "id": "wake-supervisor-runtime-state",
      "kind": "directory",
      "envOverrides": [
        "OPK_WAKE_SUPERVISOR_STATE_DIR",
        "ORCHESTRATOR_PACK_WAKE_SUPERVISOR_STATE_DIR",
        "OPK_SIDE_PROCESS_STATE_DIR"
      ],
      "canonicalDefault": "${WAKE_STATE}",
      "sidecars": [],
      "harnessPath": "wake"
    },
    {
      "id": "worker-status-store",
      "kind": "file",
      "envOverrides": ["OPK_WORKER_STATUS_STORE"],
      "canonicalDefault": "${WAKE_STATE}/worker-status-store.json",
      "sidecars": ["worker-status-store*"],
      "harnessPath": "wake/worker-status-store.json"
    },
    {
      "id": "worker-report-store",
      "kind": "file",
      "envOverrides": ["OPK_WORKER_REPORT_STORE"],
      "canonicalDefault": "${WAKE_STATE}/worker-report-store.json",
      "sidecars": ["worker-report-store*"],
      "harnessPath": "wake/worker-report-store.json"
    },
    {
      "id": "pr-session-binding-cache",
      "kind": "file",
      "envOverrides": ["OPK_PR_SESSION_BINDING_CACHE"],
      "canonicalDefault": "${WAKE_STATE}/pr-session-binding-cache.json",
      "sidecars": ["pr-session-binding-cache*"],
      "harnessPath": "wake/pr-session-binding-cache.json"
    },
    {
      "id": "review-start-claims",
      "kind": "directory",
      "envOverrides": ["OPK_REVIEW_CLAIM_DIR"],
      "canonicalDefault": "${OPK_BASE}/projects/orchestrator-pack/review-start-claims",
      "sidecars": [".locks/*", "terminal/*", "audit/*"],
      "harnessPath": "pack-state/projects/orchestrator-pack/review-start-claims"
    },
    {
      "id": "worker-nudge-claims",
      "kind": "directory",
      "envOverrides": ["OPK_WORKER_NUDGE_CLAIM_DIR"],
      "canonicalDefault": "${OPK_BASE}/projects/orchestrator-pack/worker-nudge-claims",
      "sidecars": [".lock-*", "terminal/*", "by-store-id/*"],
      "harnessPath": "pack-state/projects/orchestrator-pack/worker-nudge-claims"
    },
    {
      "id": "worker-nudge-audit",
      "kind": "directory",
      "envOverrides": [],
      "canonicalDefault": "${OPK_BASE}/projects/orchestrator-pack/worker-nudge-gate-audit",
      "sidecars": [],
      "harnessPath": "pack-state/projects/orchestrator-pack/worker-nudge-gate-audit"
    },
    {
      "id": "mechanical-transport",
      "kind": "directory",
      "envOverrides": ["OPK_MECHANICAL_TRANSPORT_TEMP"],
      "canonicalDefault": "${HOME}/.orchestrator-mechanical-transport",
      "sidecars": ["*.in.json", "*.out.json", "*.payload"],
      "harnessPath": "transport"
    }
  ]
}
